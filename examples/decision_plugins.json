{
  "schema": "polar.sim.decision-plugins.v1",
  "adapters": [
    {
      "adapter_id": "custom_reviewed_team_decision",
      "label": "Reviewed external decision wrapper; provide the local implementation",
      "command": ["{python}", "-u", "reviewed_decision_wrapper.py"],
      "cwd": "..",
      "supported_robots": ["red_sentry", "blue_sentry"],
      "transport": "jsonl_v1",
      "capabilities": {
        "schema": "polar.sim.decision-plugin.capabilities.v1",
        "observation_schema": "polar.sim.decision-observation.v1",
        "intent_schema": "polar.sim.decision-intent.v1",
        "sensor_profile": "own_referee_v1",
        "output_modes": ["navigation_intent"],
        "source_association": "exact_observation_context_v1",
        "fire_authority": "none",
        "ui_config_contract": "empty_v1"
      }
    }
  ]
}
