+                plan=make_plan(c,'red_sentry',{'aim':aid},{'command':['bad'],'model_path':'bad','V2 Aim FOV':False})
+                self.assertEqual(plan,{'aim':dict(adapter_id=aid,config={})})
+                self.assertEqual(options(c,'blue_sentry','aim'),['Manual'])
