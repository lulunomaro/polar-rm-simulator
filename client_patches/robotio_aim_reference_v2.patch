+"""Exact declared aim-v2 negotiation; synthetic metadata, no algorithm evidence."""
+import copy
+import unittest
+from rm_client.sim_platform_adapters import (PLUGIN_CAPABILITIES,PLUGIN_CAPABILITIES_V2,
+    parse_catalog,options,make_plan)
+
+
+def catalog(aid='custom_inertial_aim',robot='red_infantry',transport='jsonl_v1'):
+    d=dict(adapter_id=aid,kind='aim',version='2.0.0',label='Source-base inertial aim interface',
+        available=True,required_sensors=['camera','odometry'],supported_robots=[robot],
+        fire_authority='manual_only',output_modes=['gimbal_target'],ui_config_contract='empty_v1',
+        aim_plugin_contract='camera_gimbal_v2',plugin_transport=transport,local_registration=True,
+        capability_negotiation='exact_peer_capabilities_on_prepare_and_reset',
+        aim_reference='inertial_from_source_base_v1',aim_plugin_capabilities=copy.deepcopy(PLUGIN_CAPABILITIES_V2))
+    return dict(schema='rm.sim.platform.v2',adapter_ui_version=1,adapter_activation_version=1,
+        readiness='declared_support_only',fire_authority='manual_only',adapters=[d],
+        robots=[dict(robot_id=robot,declared_sensors=['camera','odometry']),
+                dict(robot_id='blue_infantry',declared_sensors=['camera','odometry'])])
+
+
+class AimReferenceDiscoveryTests(unittest.TestCase):
+    def test_independent_ids_share_explicit_v2_and_bind_no_user_config(self):
+        for aid,transport in (('custom_independent_aim','jsonl_v1'),('custom_other_team_aim','wsl_jsonl_v1')):
+            with self.subTest(aid=aid):
+                raw=catalog(aid,transport=transport);before=copy.deepcopy(raw);parsed=parse_catalog(raw)
+                self.assertEqual(options(parsed,'red_infantry','aim'),['Manual',aid])
+                self.assertEqual(options(parsed,'blue_infantry','aim'),['Manual'])
+                self.assertEqual(make_plan(parsed,'red_infantry',{'aim':aid},
+                    {'command':['forbidden'],'model_path':'forbidden','V2 Aim FOV':False}),
+                    {'aim':dict(adapter_id=aid,config={})})
+                self.assertEqual(raw,before)
+    def test_both_v1_and_v2_remain_explicit_distinct_options(self):
+        raw=catalog();v1=copy.deepcopy(raw['adapters'][0]);v1.update(adapter_id='custom_legacy_aim',
+            version='1.0.0',required_sensors=['camera'],aim_plugin_contract='camera_gimbal_v1',
+            aim_plugin_capabilities=copy.deepcopy(PLUGIN_CAPABILITIES))
+        for k in ('aim_reference','capability_negotiation'):v1.pop(k)
+        raw['adapters'].append(v1)
+        self.assertEqual(options(parse_catalog(raw),'red_infantry','aim'),
+            ['Manual','custom_inertial_aim','custom_legacy_aim'])
+        v1['aim_reference']='inertial_from_source_base_v1'
+        self.assertNotIn('custom_legacy_aim',options(parse_catalog(raw),'red_infantry','aim'))
+    def test_v2_rejects_mixed_missing_unknown_or_unacknowledged_metadata(self):
+        cases=[('version','1.0.0'),('version','2.1.0'),('aim_plugin_contract','camera_gimbal_v1'),
+            ('aim_reference','base_link'),('local_registration',1),('capability_negotiation','declared_only'),
+            ('required_sensors',['camera']),('required_sensors',['odometry','camera']),
+            ('plugin_transport','ros2_envelope_v1'),('plugin_transport','shell'),
+            ('supported_robots',['red_infantry','red_infantry']),('supported_robots',[True]),
+            ('output_modes',['velocity_body']),('fire_authority','automatic'),('ui_config_contract','exec'),
+            ('test_only',True),('available',1),('command',['local']),('cwd','local')]
+        for key,value in cases:
+            with self.subTest(key=key,value=value):
+                raw=catalog();raw['adapters'][0][key]=value
+                self.assertEqual(options(parse_catalog(raw),'red_infantry','aim'),['Manual'])
+        for key in ('aim_reference','aim_plugin_capabilities','capability_negotiation','local_registration'):
+            with self.subTest(missing=key):
+                raw=catalog();raw['adapters'][0].pop(key)
+                self.assertEqual(options(parse_catalog(raw),'red_infantry','aim'),['Manual'])
+    def test_full_typed_capabilities_and_sensor_provider_required(self):
+        for key,value in [('schema','polar.sim.aim-plugin.capabilities.v3'),('gimbal_reference','base_link'),
+            ('sensor_profile','truth_pose'),('image_encodings',('rgb8','bgr8')),('output_modes',['gimbal_target',True]),
+            ('fire_authority',True),('unknown',True)]:
+            with self.subTest(key=key):
+                raw=catalog();raw['adapters'][0]['aim_plugin_capabilities'][key]=value
+                self.assertEqual(options(parse_catalog(raw),'red_infantry','aim'),['Manual'])
+        for sensor in ('camera','odometry'):
+            raw=catalog();raw['robots'][0]['declared_sensors'].remove(sensor)
+            self.assertEqual(options(parse_catalog(raw),'red_infantry','aim'),['Manual'])
+            with self.assertRaises(ValueError):make_plan(parse_catalog(raw),'red_infantry',{'aim':'custom_inertial_aim'},{})
+
+
+if __name__=='__main__':unittest.main()
