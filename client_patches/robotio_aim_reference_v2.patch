+"""Original Qt chooser and claim/arm/bind path; synthetic SDK, no NN/physics."""
+import copy
+import os
+import unittest
+os.environ.setdefault('QT_QPA_PLATFORM','offscreen')
+from PySide6.QtCore import QPointF,QRectF,Qt,QEvent
+from PySide6.QtGui import QKeyEvent
+from test_platform_adapters import OriginalUiTests
+from test_aim_reference_discovery import catalog
+from platform_v2_fixtures import install_owned_state
+
+
+class AimReferenceUiTests(OriginalUiTests):
+    def install(self,raw=None,serial=2):
+        self.t.install_catalog(catalog() if raw is None else raw,
+            connection_generation=self.t._connection_generation,serial=serial)
+        self.r.sync_adapters(self.w);self.app.processEvents()
+        return self.w.registry.get('RobotProfile').get_setting('V2 Aim')
+    def choose(self,aid='custom_inertial_aim'):
+        setting=self.w.registry.get('RobotProfile').get_setting('V2 Aim')
+        self.w.dispatch('jello_mode_select',(setting,aid),QPointF(),1,QRectF(0,0,100,20))
+    def f2(self):self.w.keyPressEvent(QKeyEvent(QEvent.Type.KeyPress,Qt.Key.Key_F2,Qt.KeyboardModifier.NoModifier))
+    def test_actual_qt_v2_choice_then_original_claim_ownhud_arm_bind_and_manual_fire(self):
+        setting=self.install();self.assertIn('custom_inertial_aim',setting.options)
+        self.choose();self.assertEqual(self.t.plan,{'aim':dict(adapter_id='custom_inertial_aim',config={})})
+        self.assertFalse(self.r.armed)
+        self.assertFalse(any(c[0] in ('claim','bind','pulse') for c in self.c.calls))
+        self.assertTrue(self.w.setting_is_unavailable(self.w.registry.get('RobotProfile').get_setting('V2 Aim FOV')))
+        self.f2();self.t.process_jobs();self.assertFalse(self.r.armed)
+        self.assertFalse(any(c[0]=='bind' for c in self.c.calls))
+        install_owned_state(self.t);self.f2();self.assertTrue(self.r.armed)
+        self.t.submit_input(vx_mps=0,vy_mps=0,fire=False);self.t.control_tick()
+        self.assertIn(('bind','red_infantry','aim','custom_inertial_aim',{}),self.c.calls)
+        self.assertFalse(any(c[0]=='pulse' for c in self.c.calls))
+        self.t.submit_input(vx_mps=0,vy_mps=0,fire=False);self.t.control_tick()
+        self.t.submit_input(vx_mps=0,vy_mps=0,fire=True);self.t.control_tick()
+        pulses=[c for c in self.c.calls if c[0]=='pulse']
+        self.assertTrue(pulses);self.assertTrue(all(c[2]=='aim' and c[4]['valid_for_s']==.15 for c in pulses))
+        controls=[c for c in self.c.calls if c[0]=='control']
+        self.assertNotIn('gimbal',[c[2] for c in controls])
+        self.assertTrue(any(c[2]=='fire' and c[3]['fire'] is True for c in controls))
+        self.t.neutral('focus lost');before=len(pulses);self.t.control_tick()
+        self.assertFalse(self.t._focus);self.assertEqual(before,len([c for c in self.c.calls if c[0]=='pulse']))
+    def test_catalog_reference_change_revokes_selection_without_binding_new_contract(self):
+        self.install();self.choose();self.assertTrue(self.t.plan)
+        raw=catalog();raw['adapters'][0]['aim_plugin_capabilities']['gimbal_reference']='unknown'
+        setting=self.install(raw,3)
+        self.assertNotIn('custom_inertial_aim',setting.options)
+        self.assertEqual(self.t.plan,{});self.assertFalse(self.r.armed)
+        self.assertFalse(any(c[0] in ('bind','pulse') for c in self.c.calls))
+    def test_missing_odometry_other_robot_and_spectator_cannot_bind_v2(self):
+        raw=catalog();raw['robots'][0]['declared_sensors']=['camera']
+        setting=self.install(raw);self.assertNotIn('custom_inertial_aim',setting.options)
+        self.install(serial=3);self.r.select_robot(self.w,'red_sentry');self.r.sync_adapters(self.w)
+        self.assertNotIn('custom_inertial_aim',setting.options)
+        self.t.role='spectator';self.assertTrue(self.w.setting_is_unavailable(setting))
+        with self.assertRaises(ValueError):self.t.configure_adapters({'aim':'custom_inertial_aim'}, {})
+        self.assertFalse(any(c[0] in ('claim','bind','pulse') for c in self.c.calls))
+
+
+def load_tests(loader,tests,pattern):
+    return unittest.TestSuite(AimReferenceUiTests(n) for n,v in AimReferenceUiTests.__dict__.items()
+        if n.startswith('test_') and callable(v))
+if __name__=='__main__':unittest.main()
