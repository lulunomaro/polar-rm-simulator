+
+
+def state(*,owned=False,stamp=1.,server_now=1000.,expires=1001.,alive=True):
+    rows=[];leases={};bindings={}
+    for team in ('red','blue'):
+        for role in ('hero','infantry','sentry'):
+            rid=team+'_'+role;row=dict(robot_id=rid,team=team,role=role)
+            live=owned and rid=='red_infantry'
+            if live:row.update(hp=300.,max_hp=300.,ammo=20.,heat=0.,heat_max=100.,alive=alive,gimbal_yaw=.25,gimbal_pitch=-.1)
+            rows.append(row)
+            leases[rid]={c:dict(owner='own-session' if live else None,epoch=2 if live else 0,occupied=live,**({'expires':expires,'input':None,'input_expires':0.} if live else {})) for c in ('motion','gimbal','fire')}
+            bindings[rid]={k:{'owner':None} for k in ('navigation','aim')}
+    return dict(schema='rm.sim.platform.v2',display_schema='polar.sim.display.v2',source='operator_limited_display',
+        data_plane='operator_limited_display',state_projection_version=1,algorithm_input=False,sim_time=stamp,
+        sample_sim_time=stamp,episode=0,phase='running',remaining_seconds=299.,robots=rows,
+        control=dict(robot_ids=[r['robot_id'] for r in rows],leases=leases,bindings=bindings,
+                     stopped=False,server_monotonic_s=server_now,revision=1),applied_targets={})
+
+
+class OperatorProjectionTests(unittest.TestCase):
+    def setUp(self):
+        self.now=[10.];self.client=Client()
+        self.t=PlatformTransport(role='operator',clock=lambda:self.now[0],client=self.client)
