+"""Explicit synthetic state/camera fixtures without importing the Qt window."""
+import base64
+import copy
+import cv2
+import numpy as np
+
+class Client:
+    uncertain=False;session_id='synthetic-client'
+    def __init__(self):self.calls=[];self.epoch=0;self.lease_epoch=0
+    def open(self,role):return dict(schema='rm.sim.platform.v2',session_id=self.session_id,role=role)
+    def watch(self,rid):self.calls.append(('watch',rid));self.epoch+=1;return dict(robot_id=rid,watch_epoch=self.epoch)
+    def claim(self,rid,channels):self.calls.append(('claim',rid));self.lease_epoch+=1;return dict(robot_id=rid,lease_epochs={c:self.lease_epoch for c in channels})
+    def release(self,rid,channels):self.calls.append(('release',rid));return {'released':True}
+    def renew(self,rid,channels):self.calls.append(('renew',rid));return {}
+    def control(self,rid,ch,value,**kw):self.calls.append(('control',rid,ch,copy.deepcopy(value)));return {'accepted':True}
+    def keepalive(self):self.calls.append(('keepalive',));return {}
+    def close(self):self.calls.append(('close',))
+
+def state(*,complete=True,episode=0,stamp=1.,owner=None,epoch=1,role='operator'):
+    robots=[]
+    for team in ('red','blue'):
+        for role in ('hero','infantry','sentry'):
+            r=dict(robot_id=team+'_'+role,team=team,role=role,xy=[0.,0.],hp=300.,alive=True,yaw=0.,gimbal_yaw=0.,gimbal_pitch=0.,vx=0.,vy=0.,wz=0.)
+            if complete:r.update(max_hp=300.,ammo=25.,heat=0.,heat_max=100.)
+            robots.append(r)
+    value=dict(schema='rm.sim.platform.v2',source='simulator_truth_display_only',algorithm_input=False,sim_time=stamp,episode=episode,phase='running',robots=robots,control={'leases':{'red_infantry':{c:{'owner':owner,'epoch':epoch} for c in ('motion','gimbal','fire')}}})
+    if complete:value.update(remaining_seconds=299.,victory_points={'red':0,'blue':0})
+    if role=='spectator':return value
+    leases={};bindings={};limited=[]
+    for row in robots:
+        rid=row['robot_id'];own=owner is not None and rid=='red_infantry'
+        small={k:row[k] for k in ('robot_id','team','role')}
+        if own:small.update({k:row[k] for k in ('hp','alive','gimbal_yaw','gimbal_pitch','max_hp','ammo','heat','heat_max') if k in row})
+        limited.append(small)
+        leases[rid]={c:dict(owner=owner if own else None,epoch=epoch if own else 0,occupied=own,**({'expires':101.,'input_expires':0.,'input':None} if own else {})) for c in ('motion','gimbal','fire')}
+        bindings[rid]={k:{'owner':None} for k in ('navigation','aim')}
+    return dict(schema='rm.sim.platform.v2',source='operator_limited_display',data_plane='operator_limited_display',
+        state_projection_version=1,algorithm_input=False,sim_time=stamp,sample_sim_time=stamp,episode=episode,
+        phase='running',robots=limited,remaining_seconds=value.get('remaining_seconds'),control=dict(robot_ids=[r['robot_id'] for r in limited],leases=leases,bindings=bindings,server_monotonic_s=100.,stopped=False,revision=1),applied_targets={})
+
+def frame(t,*,seq=1,age=0.,robot=None,watch_epoch=None,episode=0):
+    image=np.zeros((6,8,3),dtype=np.uint8);ok,encoded=cv2.imencode('.jpg',image);assert ok
+    value=dict(schema='rm.sim.platform.v2',available=True,reason='available',robot_id=robot or t.watch_robot,watch_epoch=t.watch_epoch if watch_epoch is None else watch_epoch,episode=episode,frame_seq=seq,capture_sim_time=.9,age_wall_s=age,max_frame_age_wall_s=2.5,capture_wall_monotonic=100.-age,encode_completed_wall_monotonic=100.,source='simulated_raw_camera_display_jpeg',full_frame=True,algorithm_input=False,own_qpos_at_capture=[0.]*5,own_qvel_at_capture=[0.]*5,own_odom_at_capture=[0.]*3,own_odom_velocity_at_capture=[0.]*3,calibration={'intrinsics':{'fx':10.,'fy':10.,'cx':4.,'cy':3.,'distortion_model':'brown_conrady_5','distortion':[0.]*5},'extrinsics':{'parent_frame':'gimbal_link','translation_m':[.24,0.,.06],'rotation_xyzw':[-.5,.5,-.5,.5],'calibration_id':'synthetic-fixture'}},image=dict(encoding='jpeg',width=8,height=6,data_base64=base64.b64encode(encoded.tobytes()).decode()))
+    if t.role=='operator':
+        value['source']='operator_camera_display_v1'
+        value['data_plane']='operator_limited_display';value['camera_display_version']=1
+        for key in ('own_qpos_at_capture','own_qvel_at_capture','own_odom_at_capture','own_odom_velocity_at_capture'):value.pop(key)
+    return value
+
+def install_owned_state(t,*,complete=True):
+    """A new synthetic server HUD sample after claim ACK; never auto-arm."""
+    epoch=t.owned_epochs.get('motion',1)
+    return t.install_state(state(owner=t.client.session_id,epoch=epoch,complete=complete,
+                                 stamp=(t.raw_state or {}).get('sim_time',1.)+.001))
