{
  "autoaim": {
    "detector": {
      "model_location": "@MODEL_PATH@",
      "infer_device": "CPU",
      "use_roi_segment": false,
      "roi_rows": 640,
      "roi_cols": 640,
      "input_rows": 640,
      "input_cols": 640,
      "min_confidence": 0.5,
      "score_threshold": 0.7,
      "nms_threshold": 0.3,
      "green_light_filter": {
        "green_threshold": 120,
        "min_area": 20,
        "min_circularity": 0.6,
        "max_aspect_ratio": 1.5
      }
    },
    "tracker": {
      "fallback_color": "BLUE",
      "timeout_seconds": 1.5,
      "image_margin": 10,
      "robot": {
        "noise_x": "1e-4",
        "noise_y": "1e-4",
        "noise_z": "1e-8",
        "noise_vx": "2e-1",
        "noise_vy": "2e-1",
        "noise_vz": "1e-8",
        "noise_rotation_angle": "1e-4",
        "noise_rotation_speed": "2e-1",
        "noise_observation": 40.0
      },
      "outpost": {
        "process_noise_xy": "1e-6",
        "process_noise_z": "1e-5",
        "process_noise_speed": "1e-4",
        "process_noise_angle": "1e-4",
        "observation_noise_xy": 0.005,
        "observation_noise_z": 0.01,
        "observation_noise_yaw": 0.01,
        "plate_switch_yaw_min": 50.0
      }
    },
    "pose_estimator": {
      "distance_optimizer": true,
      "fixed_outpost_pitch": true,
      "fixed_normal_pitch": false,
      "outpost_armor_thickness": 0.022
    },
    "virtual_rune": {
      "enable": false
    }
  },
  "executor": {
    "auto_aim_component": {
      "ros__parameters": {
        "manual_shoot": false,
        "fire_control": {
          "bullet_speed": 22.5,
          "shoot_delay": 0.04,
          "offset_yaw": 0.0,
          "offset_pitch": 0.0,
          "attack_window": 120.0,
          "degraded_angle_speed": 12.0,
          "window_redundancy": 0.8,
          "attack_preaim": true,
          "window_hysteresis": 0.2,
          "yaw_tolerance": 0.07,
          "pitch_tolerance": 0.04,
          "rune_idle_duration": 0.4,
          "rune_shoot_duration": 0.2,
          "muzzle_offset_x": 0.38,
          "muzzle_offset_y": 0.0,
          "muzzle_offset_z": 0.0
        }
      }
    }
  }
}
