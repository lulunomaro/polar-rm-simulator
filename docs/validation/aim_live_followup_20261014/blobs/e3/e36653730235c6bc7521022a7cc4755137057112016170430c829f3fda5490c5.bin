from pathlib import Path
import json,runpy,sys
ROOT=Path('C:\\Users\\lulu\\Desktop\\claude\\polarsimulation\\polar-rm-simulator')
sys.path.insert(0,str(ROOT))
original=sys.getswitchinterval()
sys.setswitchinterval(0.001)
(ROOT/'artifacts/aim-gil-driver-20261014-production-cpu4-hostcv4-async-gil1ms-affinity16-04/SCHEDULING_PROFILE.json').write_text(json.dumps(dict(original_switch_interval_s=original,actual_switch_interval_s=sys.getswitchinterval(),qualification="explicit resource scheduling diagnostic; original 80/150ms unchanged"),indent=2))
import ctypes,threading,time
from rm_match.platform_v2.runtime import PlatformRuntime
kernel=ctypes.WinDLL('kernel32',use_last_error=True)
kernel.GetCurrentThread.restype=ctypes.c_void_p
kernel.SetThreadAffinityMask.argtypes=[ctypes.c_void_p,ctypes.c_size_t]
kernel.SetThreadAffinityMask.restype=ctypes.c_size_t
original_run=PlatformRuntime.run
def run_with_local_affinity(self,*args,**kwargs):
    thread=kernel.GetCurrentThread()
    previous=kernel.SetThreadAffinityMask(thread,16)
    if not previous:raise ctypes.WinError(ctypes.get_last_error())
    record=dict(native_thread_id=threading.get_native_id(),requested_mask=16,previous_mask=previous,qualification='Only this authority thread; processor class unqualified; original source/clock/gates and physics unchanged')
    try:return original_run(self,*args,**kwargs)
    finally:
        restored=kernel.SetThreadAffinityMask(thread,previous)
        record['restore_succeeded']=bool(restored)
        (ROOT/'artifacts/aim-gil-driver-20261014-production-cpu4-hostcv4-async-gil1ms-affinity16-04/AUTHORITY_AFFINITY.json').write_text(json.dumps(record,indent=2))
        if not restored:raise ctypes.WinError(ctypes.get_last_error())
PlatformRuntime.run=run_with_local_affinity
sys.argv[0]=str(ROOT/"tools/smoke_wsl_native_live.py")
runpy.run_path(sys.argv[0],run_name="__main__")
