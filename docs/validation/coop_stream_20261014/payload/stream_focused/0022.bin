"""Actual saved DTO framing micro-measurement; no peer/NN/physics or replay."""
import hashlib,importlib.util,json,statistics,sys,time
from pathlib import Path
HERE=Path(__file__).resolve().parent;ROOT=HERE.parents[1];sys.path.insert(0,str(ROOT))
from rm_match.deployment.wsl_jsonl_worker import RequestFramer
AUDIT=ROOT/'artifacts/pb2025-aim-controlled-fast-audit-20261014-01/audit.py'
INPUT=ROOT/'artifacts/pb2025-aim-controlled-fast-probe-20261014-01/host_attempt1/OBSERVATION.json'
spec=importlib.util.spec_from_file_location('_saved_wire_reconstruction',AUDIT)
module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
original=INPUT.read_bytes();source_before={str(p.relative_to(ROOT)):hashlib.sha256(p.read_bytes()).hexdigest()
    for p in (INPUT,AUDIT,ROOT/'rm_match/deployment/wsl_jsonl_worker.py')}
observation=json.loads(original);wire=module.wire(module.source_order(observation))
chunks=[wire[n:n+65536] for n in range(0,len(wire),65536)]
def old():
    buffer=bytearray();lines=[]
    for part in chunks:
        buffer.extend(part)
        if b'\n' in buffer:
            line,_,tail=buffer.partition(b'\n');buffer=bytearray(tail)
            if b'\n' in buffer:raise ValueError('multiple lines')
            lines.append(bytes(line))
    assert not buffer and lines==[wire[:-1]]
def repaired():
    framer=RequestFramer();lines=[]
    for part in chunks:
        line=framer.feed(part,pending=False)
        if line is not None:lines.append(line)
    assert not framer.buffer and lines==[wire[:-1]]
samples={'old_repeated_prefix_scan':[],'new_incremental_scan':[]}
for trial in range(20):
    paired=[('old_repeated_prefix_scan',old),('new_incremental_scan',repaired)]
    if trial%2:paired.reverse()
    for label,callback in paired:
        started=time.perf_counter();callback();samples[label].append(time.perf_counter()-started)
source_after={name:hashlib.sha256((ROOT/name).read_bytes()).hexdigest() for name in source_before}
result=dict(schema='polar.wsl.saved-framing-micro.v1',
    input_sha256=hashlib.sha256(original).hexdigest(),reconstructed_wire_bytes=len(wire),
    reconstructed_wire_sha256=hashlib.sha256(wire).hexdigest(),chunk_size=65536,chunk_count=len(chunks),paired_trials=20,
    identical_complete_line_bytes=True,source_before=source_before,source_after=source_after,
    source_unchanged=source_before==source_after,
    samples_s=samples,summary={key:dict(p50_ms=statistics.median(values)*1000,min_ms=min(values)*1000,max_ms=max(values)*1000) for key,values in samples.items()},
    scope='Local saved actual DTO + source-order reconstructed wire; original capture timestamps unchanged; isolated LF/buffer work only',
    live_qualified=False,nn_requests=0,physics_steps=0,wire_sent_to_peer=False,
    limitation='Not captured original OS wire, not transport/NN latency, no STOP file call included; no 80ms inference or live qualification')
(HERE/'SAVED_FRAMING_RESULT.json').write_text(json.dumps(result,indent=2,allow_nan=False)+'\n',encoding='utf8')
print(json.dumps({key:value for key,value in result.items() if key not in ('samples_s','source_before','source_after')},indent=2))
if not result['source_unchanged']:raise SystemExit(2)
